# Copy to secrets.env and fill in (secrets.env is git-ignored). Values live in Bitwarden.

# API Gemini Cli
export GEMINI_API_KEY=

# GitHub token (fallback — bash_profile overrides this with `gh auth token` when gh is available)
export GITHUB_PERSONAL_ACCESS_TOKEN=

# Jira MCPs, read by setup-claude-mcps.sh (URL like https://<site>.atlassian.net)
export JIRA_INTELIFI_URL=
export JIRA_INTELIFI_USERNAME=
export JIRA_INTELIFI_API_TOKEN=

export JIRA_BRATSTVO_URL=
export JIRA_BRATSTVO_USERNAME=
export JIRA_BRATSTVO_API_TOKEN=
